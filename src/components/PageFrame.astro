---
// @spec SITE-UI-NAV-002
// Starlight's PageFrame, with the menu button and sidebar pane also on pages without a sidebar
// (the home page). There they act as a menu below 72rem, where the header links are hidden.
import MobileMenuToggle from 'virtual:starlight/components/MobileMenuToggle';
import Sidebar from 'virtual:starlight/components/Sidebar';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="page sl-flex">
	<header class="header"><slot name="header" /></header>
	<nav class:list={['sidebar print:hidden', { 'menu-only': !hasSidebar }]} aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
		<MobileMenuToggle />
		<script>
			class StarlightSidebarPane extends HTMLElement {
				constructor() {
					super();
					const desktop = matchMedia(this.closest('.menu-only') ? '(min-width: 72em)' : '(min-width: 50em)');
					const reset = () => { this.popover = desktop.matches ? null : 'auto'; };
					reset();
					desktop.addEventListener('change', reset);
					this.addEventListener('toggle', ({ newState }: any) => this.trapFocus(newState === 'open'));
				}
				trapFocus(on: boolean) {
					document.querySelectorAll<HTMLElement>('.main-frame, .sl-skip-link').forEach((el) => el.toggleAttribute('inert', on));
				}
			}
			customElements.define('sl-sidebar-pane', StarlightSidebarPane);
		</script>
		<sl-sidebar-pane popover="" id="starlight__sidebar" class="sidebar-pane">
			<div class="sidebar-content sl-flex">{hasSidebar ? <slot name="sidebar" /> : <Sidebar />}</div>
		</sl-sidebar-pane>
	</nav>
	<div class="main-frame"><slot /></div>
</div>

<style>
	@layer starlight.core {
		.page { flex-direction: column; min-height: 100vh; }
		.header {
			z-index: var(--sl-z-index-navbar);
			position: fixed;
			inset-inline-start: 0;
			inset-block-start: 0;
			width: 100%;
			height: var(--sl-nav-height);
			border-bottom: 1px solid var(--sl-color-hairline-shade);
			padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
			padding-inline-end: calc(var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size));
			background-color: var(--sl-color-bg-nav);
		}
		.sidebar-pane {
			border: unset;
			padding: unset;
			height: unset;
			color: unset;
			position: fixed;
			z-index: var(--sl-z-index-menu);
			inset-block: var(--sl-nav-height) 0;
			inset-inline-start: 0;
			width: 100%;
			background-color: var(--sl-color-black);
			overflow-y: auto;
			scrollbar-gutter: stable;
		}
		.sidebar-content {
			height: 100%;
			min-height: max-content;
			padding: 1rem var(--sl-sidebar-pad-x) 0;
			flex-direction: column;
			gap: 1rem;
		}
		.main-frame {
			padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
			padding-inline-start: var(--sl-content-inline-start);
		}
		@media (min-width: 50rem) {
			:global(:root[data-has-sidebar]) .header { padding-inline-end: var(--sl-nav-pad-x); }
			.sidebar-content::after { content: ''; padding-bottom: 1px; }
			.sidebar:not(.menu-only) .sidebar-pane {
				display: block;
				width: var(--sl-sidebar-width);
				background-color: var(--sl-color-bg-sidebar);
				border-inline-end: 1px solid var(--sl-color-hairline-shade);
			}
		}
		@media (min-width: 72rem) {
			.header { padding-inline-end: var(--sl-nav-pad-x); }
			.menu-only { display: none; }
		}
	}
	@media (min-width: 50rem) and (max-width: 71.99rem) {
		.menu-only :global(.sl-menu-button) { display: flex; }
	}
</style>

---
// @spec SITE-UI-NAV-001
import Default from '@astrojs/starlight/components/SiteTitle.astro';
const NAV: [string, string][] = [
  ['Why', '/why/why-indextables/'], ['Learn', '/learn/what-is-indextables/'], ['Get started', '/start/spark/'],
  ['Guides', '/guides/catalogs/overview/'], ['Concepts', '/concepts/architecture/'], ['Reference', '/reference/availability/'], ['Blog', '/blog/'],
];
const SECTION: Record<string, string> = { Why: '/why/', Learn: '/learn/', 'Get started': '/start/', Guides: '/guides/', Concepts: '/concepts/', Reference: '/reference/', Blog: '/blog/' };
const path = Astro.url.pathname;
---
<Default><slot /></Default>
<nav class="topnav" aria-label="Sections">
  {NAV.map(([label, href]) => <a href={href} aria-current={path.startsWith(SECTION[label]) ? 'page' : undefined}>{label}</a>)}
</nav>
<style>
  .topnav { display: flex; gap: 1.1rem; margin-left: 1.5rem; white-space: nowrap; overflow-x: auto; scrollbar-width: none; }
  .topnav a { font: 500 .9rem var(--sl-font); color: var(--sl-color-gray-2); text-decoration: none; padding: .2rem 0; border-bottom: 2px solid transparent; }
  .topnav a:hover { color: var(--sl-color-white); }
  .topnav a[aria-current='page'] { color: var(--sl-color-white); border-bottom-color: var(--marker); }
  @media (max-width: 50rem) { .topnav { display: none; } }
</style>
